# Generated outputs
/build/
/releases/
/audit/reports/*
!audit/reports/.gitkeep

# Local baseline binary inputs (kept in initialization package, not committed)
/baseline_inputs/*.zip
/baseline_inputs/*.png

# Local game reference configuration and copyrighted game files
/reference/vanilla_path.json
/reference/vanilla/
/reference/*.zip

# Game logs and saves
*.log
*.sav
# 实机回归归档的脱敏日志副本（docs/testing/<轮次>/logs/）按归档制度入库；
# 游戏用户目录的原始日志仍被上面的 *.log 排除。
!docs/testing/**/logs/**

# Python and editors
__pycache__/
*.py[cod]
.vscode/
.idea/
.DS_Store
Thumbs.db

# Office temporary files
~$*
